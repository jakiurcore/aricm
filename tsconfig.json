{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "types": ["vite/client"],
        "paths": {
          "@/*": [
            "./resources/js/*"
          ],
          "@core/*": [
            "./Modules/Core/resources/*"
          ],
          "@accounts/*": [
            "./Modules/Accounts/resources/*"
          ],
          "@academic/*": [
            "./Modules/Academic/resources/*"
          ],
          "@students/*": [
            "./Modules/Students/resources/*"
          ],
          "@exams/*": [
            "./Modules/Exams/resources/*"
          ],
          "@results/*": [
            "./Modules/Results/resources/*"
          ],
          "@admin/*": [
            "./vendor/protibimbok/laramod-admin/resources/*"
          ]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "Modules/*/resources/js/**/*.ts",
        "Modules/*/resources/js/**/*.tsx"
    ]
}
