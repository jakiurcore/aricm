{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "types": ["vite/client"],
        "paths": {
          "@/*": [
            "./resources/js/*"
          ],
          "@core/*": [
            "./Modules/Core/resources/*"
          ],
          "@accounts/*": [
            "./Modules/Accounts/resources/*"
          ],
          "@academic/*": [
            "./Modules/Academic/resources/*"
          ],
          "@teachers/*": [
            "./Modules/Teachers/resources/*"
          ],
          "@students/*": [
            "./Modules/Students/resources/*"
          ],
          "@exams/*": [
            "./Modules/Exams/resources/*"
          ],
          "@results/*": [
            "./Modules/Results/resources/*"
          ],
          "@fees/*": [
            "./Modules/Fees/resources/*"
          ],
          "@diary/*": [
            "./Modules/Diary/resources/*"
          ],
          "@notices/*": [
            "./Modules/Notices/resources/*"
          ],
          "@gallery/*": [
            "./Modules/Gallery/resources/*"
          ],
          "@admission/*": [
            "./Modules/Admission/resources/*"
          ],
          "@website/*": [
            "./Modules/Website/resources/*"
          ],
          "@student-portal/*": [
            "./Modules/StudentPortal/resources/*"
          ],
          "@teacher-panel/*": [
            "./Modules/TeacherPanel/resources/*"
          ],
          "@admin/*": [
            "./vendor/protibimbok/laramod-admin/resources/*"
          ]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "Modules/*/resources/js/**/*.ts",
        "Modules/*/resources/js/**/*.tsx"
    ]
}
