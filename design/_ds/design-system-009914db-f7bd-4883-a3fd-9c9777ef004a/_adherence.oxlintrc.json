{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "table",
            "message": "Use <DataTable> from the design system instead of <table>."
          },
          {
            "element": "dialog",
            "message": "Use <Modal> from the design system instead of <dialog>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "textarea",
            "message": "Use <TextArea> from the design system instead of <textarea>."
          },
          {
            "element": "input",
            "message": "Use <TextInput> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/Button/**",
              "components/actions/IconButton/**",
              "components/actions/SegmentedControl/**",
              "components/brand/Mark/**",
              "components/data/CodeBlock/**",
              "components/data/DataTable/**",
              "components/data/Diff/**",
              "components/data/InlineCode/**",
              "components/data/StepList/**",
              "components/forms/Checkbox/**",
              "components/forms/Field/**",
              "components/forms/Select/**",
              "components/forms/Switch/**",
              "components/forms/TextArea/**",
              "components/forms/TextInput/**",
              "components/navigation/NavBar/**",
              "components/navigation/Tabs/**",
              "components/status/CountBadge/**",
              "components/status/GateMeter/**",
              "components/status/ProgressBar/**",
              "components/status/SeverityStrip/**",
              "components/status/Spinner/**",
              "components/status/StatusPill/**",
              "components/surfaces/Card/**",
              "components/surfaces/EmptyState/**",
              "components/surfaces/HardCandyRoot/**",
              "components/surfaces/Modal/**",
              "components/surfaces/Panel/**",
              "components/surfaces/Toast/**",
              "components/typography/Heading/**",
              "components/typography/Text/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Mono|Karla))/i]",
        "message": "Font not provided by the design system. Available: Space Mono, Karla."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|block|icon|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, block, icon, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tinted|interactive|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tinted, interactive, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, hint, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|caption|className|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, caption, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|max|accent|className|key|ref|className|style|children)$/]",
        "message": "<CountBadge> doesn't accept that prop. Declared props: count, max, accent, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|rowKey|isSelected|label|className|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, rowKey, isSelected, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Diff'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|className|key|ref|className|style|children)$/]",
        "message": "<Diff> doesn't accept that prop. Declared props: lines, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|action|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, action, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|optional|children|className|htmlFor|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, optional, children, className, htmlFor."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:checks|label|className|key|ref|className|style|children)$/]",
        "message": "<GateMeter> doesn't accept that prop. Declared props: checks, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardCandyRoot'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|children|className|key|ref|className|style|children)$/]",
        "message": "<HardCandyRoot> doesn't accept that prop. Declared props: theme, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardCandyRoot'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<HardCandyRoot> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|size|children|className|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, size, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|l|m|s)$/]",
        "message": "<Heading> size must be one of 'xl' | 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|bare|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, bare, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<InlineCode> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|flat|className|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: size, flat, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onClose|dismissable|width|footer|children|className|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, subtitle, onClose, dismissable, width, footer, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:wordmark|items|active|onNavigate|actions|className|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: wordmark, items, active, onNavigate, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|actions|footer|flat|bleed|children|className|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, actions, footer, flat, bleed, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|className|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|label|className|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|invalid|placeholder|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, invalid, placeholder, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|stretch|height|className|key|ref|className|style|children)$/]",
        "message": "<SeverityStrip> doesn't accept that prop. Declared props: status, stretch, height, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeverityStrip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pass|fail|hold|running|queued|info)$/]",
        "message": "<SeverityStrip> status must be one of 'pass' | 'fail' | 'hold' | 'running' | 'queued' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|className|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|hideGlyph|className|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, children, hideGlyph, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pass|fail|hold|running|queued|info)$/]",
        "message": "<StatusPill> status must be one of 'pass' | 'fail' | 'hold' | 'running' | 'queued' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepList'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|className|key|ref|className|style|children)$/]",
        "message": "<StepList> doesn't accept that prop. Declared props: steps, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|label|actions|className|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, label, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|inline|children|className|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: variant, tone, inline, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:prose|prose-l|body|label|data|micro)$/]",
        "message": "<Text> variant must be one of 'prose' | 'prose-l' | 'body' | 'label' | 'data' | 'micro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|faint)$/]",
        "message": "<Text> tone must be one of 'default' | 'muted' | 'faint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|mono|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: invalid, mono, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|mono|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: invalid, mono, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|status|action|className|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: title, detail, status, action, className."
